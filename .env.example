# Local PostgreSQL
POSTGRES_DB=medichannel
POSTGRES_USER=medichannel_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432

# Spring Boot
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/medichannel
DB_USERNAME=medichannel_app
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
FRONTEND_URL=http://localhost:3000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRATION_MINUTES=30
APP_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
APP_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_SECRET
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=CHANGE_ON_FIRST_LOGIN

# Next.js
NEXT_PUBLIC_APP_NAME=MediChannel
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
